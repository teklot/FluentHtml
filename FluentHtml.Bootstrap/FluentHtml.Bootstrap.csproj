<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>FluentHtml.Bootstrap</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Bootstrap 5 component library for FluentHtml. Provides fluent builders for Accordion, Alert, Badge, Breadcrumb, Button, Card, DashboardLayout, Dropdown, Modal, Navbar, Pagination, ProgressBar, Sidebar, Spinner, SplitLayout, Tabs, Toast, and ResponsiveLayout components.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>FluentHtml.Bootstrap</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>FluentHtml;Bootstrap;UI;Components;CSS;ServerRendered;dotnet-library</PackageTags>
    <PackageReleaseNotes>Added ProgressBarComponent, ResponsiveLayoutComponent (header/sidebar/content/footer regions), SidebarComponent (vertical navigation with HTMX support), DashboardLayoutComponent (pre-built dashboard), SplitLayoutComponent (two-panel responsive layout), BootstrapTreeComponent (expandable/collapsible tree with lazy-loading).</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/FluentHtml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/FluentHtml.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FluentHtml\FluentHtml.csproj" />
  </ItemGroup>

</Project>
