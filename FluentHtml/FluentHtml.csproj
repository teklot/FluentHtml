<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>FluentHtml.Core</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Core HTML node model and rendering pipeline for FluentHtml. Provides Node, Element, Fragment, RawHtml, TextNode, AttributeCollection, and the Renderer/HtmlWriter/HtmlEncoder types for building, composing, and rendering HTML elements with a fluent C# API.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>FluentHtml.Core</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>FluentHtml;HTML;DOM;FluentApi;Rendering;ServerRendered;dotnet-library</PackageTags>
    <PackageReleaseNotes>Added MarkdownComponent (Markdig-based, tables, code blocks, emphasis, custom pipeline), IconComponent (framework-agnostic icon abstraction), BadgeComponent, BreadcrumbComponent, and InlineScriptComponent.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/FluentHtml</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/FluentHtml.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.39.1" />
  </ItemGroup>

</Project>
